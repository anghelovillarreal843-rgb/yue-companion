# ============================================================
# YUE · configuracion privada (ARCHIVO UNICO)
# Fusion de .env + .env.example: toda la documentacion del ejemplo con tus
# valores reales. Sin claves duplicadas: cada variable aparece UNA sola vez.
# ============================================================

# --- IA de conversación: SOLO GROQ, UNA SOLA CUENTA ---------
# Esta es la ÚNICA clave que usa YUE. No hay claves de repuesto ni relevo entre
# cuentas: si esta falla, YUE lo dice claramente en vez de tirar de otra.
GROQ_API_KEY=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
# Una sola cuenta (recomendado). Ponlo en false SOLO si algún día quieres
# recuperar el relevo entre varias credenciales.
GROQ_UNA_SOLA_CUENTA=true
# Ignoradas mientras GROQ_UNA_SOLA_CUENTA=true. Se dejan vacías a propósito.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TEMPERATURE=0.85

# Si Groq retira un modelo, Yue busca otro MODELO dentro de Groq.
GROQ_MODEL_FALLBACKS=qwen/qwen3.6-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_VISION_FALLBACKS=

# --- Respuestas rápidas y siempre en español ----------------
# Los modelos de razonamiento (Qwen3, gpt-oss) escriben su monólogo interno EN
# INGLÉS dentro de la respuesta (<think>...</think>). Eso era lo que YUE leía en
# voz alta y lo que la hacía tardar tanto. Con esto en true, Groq ya no lo manda
# y además no gasta tokens (ni segundos) pensando en voz alta.
GROQ_SIN_RAZONAMIENTO=true
# YUE responde de 1 a 4 frases: este tope evita respuestas kilométricas y hace
# que conteste mucho antes. Súbelo a 400 si alguna vez quieres respuestas largas.
GROQ_MAX_TOKENS_CHAT=220
# Si aun así contestara en inglés, YUE lo vuelve a pedir en español una vez.
FORZAR_ESPANOL=true

# --- Vision de pantalla -------------------------------------
# Activa desde el inicio, pero no comenta periódicamente. /mira hace una consulta explícita.
VISION_ENABLED=true
VISION_AUTOCOMMENT=false
VISION_INTERVAL=90

# --- Camara local automatica --------------------------------
# Se conecta si encuentra una webcam. No guarda ni envia fotogramas a la IA.
CAMERA_ENABLED=false
# Indice de la webcam (la tuya es la 2). CAMERA_MAX_INDEX limita la busqueda.
CAMERA_INDEX=2
CAMERA_ANALYSIS_INTERVAL=1.2
CAMERA_RETRY_INTERVAL=60
# NUEVO (autoconexion): si NO hay camara aun, sondea cada X segundos y se
# engancha sola en cuanto enciendas/conectes una, sin reiniciar YUE.
CAMERA_SEARCH_INTERVAL=3
CAMERA_MAX_INDEX=3
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_MAX_PEOPLE=2
CAMERA_CONTEXT_IN_CHAT=true
CAMERA_CONTEXT_MAX_AGE=8

# Si es false (por defecto), YUE solo HABLA y no escribe sus respuestas en el chat.
# Ponlo en true si prefieres ver también el texto. Si la voz está apagada, el
# texto se muestra igual para que YUE no se quede muda.
CHAT_MOSTRAR_RESPUESTAS=false
# Descarga una sola vez los modelos oficiales de MediaPipe en data/models/.
CAMERA_DOWNLOAD_MODELS=true

# --- NUEVO: lectura de emociones por camara ---------------------------------
# YUE estima como te sientes por tu expresion y ACOMPANA con la cara del avatar
# (si te ve triste, se preocupa; no imita el enfado). Solo pone gesto, no habla.
CAMERA_EMPATHY_ENABLED=true
CAMERA_EMPATHY_MIN_CONFIDENCE=0.55
CAMERA_EMPATHY_MIN_GAP=8.0

# --- NUEVO: reaccion emocional al audio (musica / videos) -------------------
# YUE afina su cara con lo que SIENTE al escuchar (melancolica con algo lento y
# oscuro, tierna con algo suave, con chispa con lo movido...). Ponlo en false
# para volver a la reaccion de audio anterior.
AUDIO_FEEL_EMOTIONS=true

# --- Vision de pantalla: sin APIs externas -------------------
# La conversación usa Groq. La visión de pantalla queda local/OCR para no
# depender de Gemini, OpenRouter, Together u OpenAI.
VISION_PROVIDER=none
VISION_MODEL=
VISION_BASE_URL=
VISION_PREFLIGHT=false
VISION_OCR_ONLY=true

# --- Vision de pantalla: ajustes finos -----------------------
# Monitor que YUE mira por defecto (1 = principal).
SCREEN_VISION_MONITOR=1
# Una captura mas antigua que esto NO se analiza (segundos).
SCREEN_VISION_MAX_FRAME_AGE=3.0
# Reutilizar una observacion reciente si la pantalla no cambio (0 = sin cache).
SCREEN_VISION_CACHE_SECONDS=25
# Estrategia forzada: vacio = decide el clasificador. ocr | vision | ambos
SCREEN_VISION_STRATEGY=
# Imagen que se manda al modelo multimodal.
SCREEN_VISION_MAX_WIDTH=1280
SCREEN_VISION_JPEG_QUALITY=70
SCREEN_VISION_MAX_TOKENS=420
SCREEN_VISION_TIMEOUT=45
# Memoria temporal para video: cuantos frames recuerda (t-4 ... t).
SCREEN_VISION_TEMPORAL_FRAMES=5
SCREEN_VISION_SEND_KEYFRAME=true
# Movimiento minimo entre capturas para considerar que hay VIDEO (sin audio).
SCREEN_VIDEO_MOTION_THRESHOLD=0.18


# --- Voz -----------------------------------------------------
TTS_ENGINE=edge
TTS_ENABLED=true
KOKORO_VOICE=ef_dora
KOKORO_LANG=es
KOKORO_SPEED=1.06
# KOKORO_MODEL=assets/kokoro/kokoro-v1.0.onnx
# KOKORO_VOICES=assets/kokoro/voices-v1.0.bin
TTS_LANG=es
TTS_TLD=com.mx

# --- Microfono y antieco ------------------------------------
MIC_ENABLED=true
MIC_LANG=es-PE
MIC_DEVICE_INDEX=
MIC_ENERGY_THRESHOLD=250
MIC_DYNAMIC=true
# Silencio que marca fin de frase. Mas bajo = responde mas rapido (antes 0.8).
MIC_PAUSE=0.55
MIC_PHRASE_LIMIT=14
# Tras hablar, vuelve a escucharte antes (antes 1.2).
MIC_ECHO_COOLDOWN=0.6
MIC_ECHO_SIMILARITY=0.68
MIC_BARGE_IN_ENABLED=true
MIC_BARGE_IN_REQUIRE_WAKE_WORD=false
MIC_BARGE_IN_MIN_CHARS=5
MIC_WAKE_WORDS=yue,oye yue

# NUEVO: interrupcion por voz fiable (barge-in inteligente).
# Hace que hablarle por voz mientras ella habla la detenga, igual que al escribir.
# Ponlo en false para volver EXACTAMENTE al filtrado anterior.
MIC_BARGE_IN_SMART=true
# Longitud minima (caracteres) para interrumpir con voz que no sea una orden.
MIC_BARGE_IN_GATE_MIN_CHARS=4
# Solape de palabras con su propio TTS por encima del cual se trata como eco.
# Mas ALTO = mas permisivo con tu voz mientras habla (antes efectivo ~0.34).
MIC_BARGE_IN_ECHO_OVERLAP=0.62
# Palabras extra que fuerzan interrupcion inmediata, separadas por comas
# (ya vienen de serie: para, espera, detente, callate, oye, stop, yue...).
MIC_BARGE_IN_WORDS=

# Filtro de audio de video/musica en el microfono (peticion 2):
# mientras suena un video o musica, ese sonido NO se toma como que le hablas tu.
# Con REQUIRE_WAKE_WORD=true, di "Yue..." para que te haga caso viendo algo.
MIC_MEDIA_GUARD_ENABLED=true
MIC_MEDIA_GUARD_REQUIRE_WAKE_WORD=true
MIC_MEDIA_GUARD_MIN_CHARS=8

# --- Palabra de activacion «Yue» y avisos de consola ---
# WAKE_WORD_ENABLED=false: YUE responde a TODO lo que le digas o escribas sin que
# tengas que empezar por «Yue». Ponlo en true si prefieres que solo atienda cuando
# la llames por su nombre.
WAKE_WORD_ENABLED=false
# DEBUG_STATUS=false: no llena la terminal con avisos repetidos («modo multimedia
# activo/en reposo», «escuchando…»). Ponlo en true solo si necesitas depurar.
DEBUG_STATUS=false

# Refuerzo para que Yue no se escuche a si misma (peticion 3):
# segundos extra de vigilancia de eco tras hablar, y umbral de solape con su TTS
# (mas bajo = mas estricto).
MIC_SELF_LISTEN_TAIL=2.5
MIC_SPEAKING_ECHO_OVERLAP=0.34

# Perfilador de contenido: video normal vs video musical (peticion 1).
MEDIA_PROFILE_WINDOW=12.0
MEDIA_PROFILE_MIN_SAMPLES=6
MEDIA_PROFILE_HYSTERESIS=3
MEDIA_PROFILE_SILENCE_RATIO=0.75
MEDIA_PROFILE_MUSIC_RATIO=0.62
MEDIA_PROFILE_VOICE_RATIO=0.30
MEDIA_PROFILE_TEMPO_CV=0.18
AUDIO_MEDIA_ON_BLOCKS=2
AUDIO_MEDIA_OFF_BLOCKS=6

# Acompañamiento multimedia continuo (audio + frames + emoción + memoria).
MEDIA_COMPANION_ENABLED=true
MEDIA_COMPANION_VISUAL_ENABLED=true
MEDIA_COMPANION_COMMENTS_ENABLED=true
MEDIA_COMPANION_AVATAR_ENABLED=true
# Intervalo adaptativo: siempre entre 0.5 y 2.0 s.
MEDIA_COMPANION_VISUAL_INTERVAL=1.0
MEDIA_COMPANION_VISUAL_MIN_INTERVAL=0.5
MEDIA_COMPANION_VISUAL_MAX_INTERVAL=2.0
MEDIA_COMPANION_SCENE_CHANGE_THRESHOLD=0.025
MEDIA_COMPANION_VISUAL_STALE_SECONDS=12
MEDIA_COMPANION_VISION_TIMEOUT=18
MEDIA_COMPANION_VISION_RETRY_SECONDS=60
# Cuánto habla y cuánto tarda en volver a comentar.
MEDIA_COMPANION_COMMENT_MIN_GAP=45
MEDIA_COMPANION_COMMENT_MAX_GAP=150
MEDIA_COMPANION_SPONTANEITY=0.48
# Evolución emocional gradual.
MEDIA_COMPANION_EMOTION_INTENSITY=1.0
MEDIA_COMPANION_EMOTION_RISE_SECONDS=3.2
MEDIA_COMPANION_EMOTION_FALL_SECONDS=7.0
MEDIA_COMPANION_MUSIC_SENSITIVITY=1.0
MEDIA_COMPANION_VISUAL_SENSITIVITY=1.0
# 0 = sin movimiento al ritmo; 1 = movimiento discreto completo.
MEDIA_COMPANION_AVATAR_MOTION=0.72

# --- Avatar --------------------------------------------------
PET_HEIGHT=330
USE_VRM=true
AVATAR_WIDTH=320
AVATAR_HEIGHT=520
AVATAR_TURN=0
AVATAR_ARM_DOWN=1.48
AVATAR_ARM_FWD=0.35
AVATAR_ARM_IN=0.12
AVATAR_CAM_DIST=1.85
AVATAR_CAM_Y=-0.16
AVATAR_DEBUG=false
# Gesticulacion: 0=solo balanceo, 1=normal, 1.5=teatral
AVATAR_GESTURE_GAIN=1.0

# --- Control seguro del PC ----------------------------------
PC_MAX_ACTIONS=24
PC_MAX_CYCLES=6
PC_MAX_ACTIONS_PER_CYCLE=4
PC_VISUAL_RECHECK=true
# Ojos por OCR (necesita Tesseract, ya lo tienes)
PC_OCR_CONTEXT=true
# Apartar las ventanas de Yue del mouse (false si algo se cuelga)
PC_CLICK_THROUGH=true
PC_CLICK_THROUGH_TIMEOUT=1.0
PC_OCR_MAX_CHARS=900
PC_ACTION_PAUSE=0.08
PC_TYPE_INTERVAL=0.012
PC_MAX_TYPE_CHARS=4000
# Motor autónomo: grafo, cola, locks, recuperación y bitácora JSONL
PC_AGENT_MAX_WORKERS=3
PC_AGENT_PARALLEL=true
PC_AGENT_RETRY_ATTEMPTS=3
PC_AGENT_WAIT_TIMEOUT=10
PC_AGENT_APP_TIMEOUT=15
PC_AGENT_MAX_REPLANS=6
PC_AGENT_LOG_PATH=data/logs/pc_agent.jsonl

# ---- Verificacion por accion (¿la pantalla cambio de verdad?) ----
PC_VERIFY_ACTIONS=true
PC_VERIFY_DELAY=0.35
PC_VERIFY_HASH_DISTANCE=1
PC_VERIFY_PIXEL_RATIO=0.0015
PC_VERIFY_PIXEL_DELTA=14
# Ventanas propias de Yue que se enmascaran antes de comparar (el avatar se mueve solo)
PC_VERIFY_IGNORE_TITLES=yue_companion,yue

# ---- Contexto de UI real (pywinauto, solo Windows) ----
PC_UI_CONTEXT=true
PC_UI_MAX_ELEMENTS=40
PC_UI_MAX_WINDOWS=18

# ---- OCR de pantalla (accion click_text) ----
OCR_ENGINE=pytesseract
OCR_LANG=spa+eng
OCR_MIN_CONF=55
# Ruta a tesseract.exe si no esta en el PATH:
# OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSERACT_CMD=

# ---- Aprendizaje continuo de ordenes de PC ----
LEARNING_ENABLED=true
LEARNING_SIM_THRESHOLD=0.85
LEARNING_MIN_SUCCESSES=2
LEARNING_MIN_RATIO=0.7
LEARNING_FAIL_STREAK=2
LEARNING_LESSON_THRESHOLD=0.55
LEARNING_MAX_SKILLS=200
LEARNING_MAX_LESSONS=200
LEARNING_MAX_PLAN_STEPS=24
LEARNING_REFLECT=true

# --- Verificacion por celdas (clics pequenos) ----------------
# El ratio global no ve un digito de la calculadora. Mirando la celda que mas
# cambio, si lo detecta. Sube PC_VERIFY_TILE_RATIO si aparecen falsos positivos.
PC_VERIFY_TILES=8
PC_VERIFY_TILE_RATIO=0.02

# --- Autonomia local y segura -------------------------------
AUTONOMY_ENABLED=true
# Intervalo entre revisiones autonomas, en segundos.
AUTONOMY_INTERVAL=600
# Solo crea cuando llevas este tiempo sin escribir ni hablarle.
AUTONOMY_IDLE_SECONDS=120
AUTONOMY_NOTIFY=true
AUTONOMY_MAX_PER_SESSION=3
AUTONOMY_PC_ENABLED=true
AUTONOMY_OPEN_CREATIONS=true

# --- Seguridad emocional ------------------------------------
CRISIS_RESOURCES=Si estas en peligro inmediato, contacta a los servicios de emergencia de tu pais o a una persona de confianza.

# --- Generacion multimedia opcional -------------------------
# Sin APIs externas. Si usas generación de imágenes, se intenta localmente.
FLUX_PROVIDER=local
LOCAL_FLUX_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
FLUX_STEPS=4
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_SECONDS=16
VIDEO_FPS=30

# ---- Control PC avanzado (Jarvis) ----
PC_OFFICE_COM_ENABLED=true
PC_OFFICE_FALLBACK_KEYBOARD=true
PC_APP_SCAN_ON_START=true
PC_APP_CATALOG_MAX_AGE_HOURS=72
PC_ACTION_LOG_SIZE=8
# Permisos granulares: false = rechazo directo, aunque haya confirmación.
PERM_ENVIAR_CORREOS=true
PERM_BORRAR_ARCHIVOS=true
PERM_USAR_TERMINAL=true
PERM_INSTALAR_SOFTWARE=true
PERM_CERRAR_VENTANAS=true
PERM_SOBRESCRIBIR_ARCHIVOS=true

# ==========================================================================
# YUE V3 PERCEPTION SYSTEM (opt-in). Cámara local que estima presencia, rostro,
# emoción y atención con OpenCV + MediaPipe + DeepFace. Todo local: nunca guarda
# ni envía imágenes. APAGADO por defecto para no pelear por la webcam con el
# observador clásico. Si lo enciendes, pon CAMERA_ENABLED=false (o dale otra
# CAMERA_INDEX) para que no compitan por la misma cámara.
# ==========================================================================
VISION_V3_ENABLED=false
CAMERA_PRIVACY_MODE=true

# Perfil de rendimiento: auto | LOW | MEDIUM | HIGH
#   LOW=DeepFace/8s ~12FPS · MEDIUM=DeepFace/5s ~20FPS · HIGH=DeepFace/2s ~30FPS
VISION_PERF_PROFILE=auto
# Overrides finos (0 = usar lo del perfil)
VISION_EMOTION_INTERVAL=0
VISION_TARGET_FPS=0

# Quién comenta lo que ve (YUE | KAI) y cuánto habla
VISION_EMOTION_PERSONA=YUE
MAX_EMOTION_RESPONSES_PER_HOUR=4
# (VISION_EMOTION_MIN_CONFIDENCE se define UNA sola vez, mas abajo,
#  en el bloque de estimacion afectiva, en escala 0-1.)
VISION_EMOTION_COOLDOWN=120
VISION_AVATAR_MIN_GAP=6

# Atención: ausencia larga (s) y semiancho de la zona central "mira de frente"
VISION_ABSENCE_SECONDS=600
VISION_ATTENTION_CENTER_BAND=0.22

# ===========================================================================
# SISTEMA DE VISIÓN POR CÁMARA — MediaPipe Tasks (paquete vision/)  [ADITIVO]
# Interruptor maestro APAGADO por defecto. NO reutiliza VISION_ENABLED (pantalla).
# Privacidad: procesamiento 100% local; nunca se guardan ni envían imágenes.
# ===========================================================================
VISION_MP_ENABLED=true

# Cámara (comparte CAMERA_INDEX/WIDTH/HEIGHT/PRIVACY_MODE ya existentes).
CAMERA_TARGET_FPS=0
VISION_PERFORMANCE_MODE=low

# Módulos on/off (Holistic apaga rostro-landmarks/pose/gestos automáticamente).
VISION_FACE_DETECTOR_ENABLED=true
VISION_FACE_LANDMARKER_ENABLED=true
VISION_POSE_ENABLED=true
VISION_GESTURE_ENABLED=true
VISION_OBJECTS_ENABLED=true
VISION_IMAGE_CLASSIFIER_ENABLED=false
VISION_IMAGE_SEGMENTER_ENABLED=false
VISION_INTERACTIVE_SEGMENTER_ENABLED=false
VISION_HOLISTIC_ENABLED=false

# Frecuencias por módulo (FPS). 0 = usar el valor del perfil de rendimiento.
VISION_FACE_DETECTOR_FPS=0
VISION_FACE_LANDMARKER_FPS=0
VISION_POSE_FPS=0
VISION_GESTURE_FPS=0
VISION_OBJECT_FPS=0
VISION_CLASSIFIER_FPS=0

# Límites y confianzas.
VISION_MAX_FACES=3
VISION_MAX_HANDS=2
VISION_FACE_MIN_CONFIDENCE=0.5
VISION_POSE_MIN_CONFIDENCE=0.5
VISION_GESTURE_MIN_CONFIDENCE=0.6
VISION_OBJECT_MIN_CONFIDENCE=0.5

# Privacidad / depuración.
VISION_SAVE_FRAMES=false
VISION_EXTERNAL_UPLOAD=false
VISION_DEBUG_OVERLAY=false

# ===========================================================================
# VISIÓN AVANZADA — OCR, habitación, acciones, emociones y privacidad
# ---------------------------------------------------------------------------
# TODO esto vive dentro de VISION_MP_ENABLED. Si ese está en false (por
# defecto), nada de este bloque se ejecuta ni consume CPU/RAM.
#
# AVISO IMPORTANTE sobre la cámara: solo UN sistema puede abrir la webcam.
# Si activas VISION_MP_ENABLED=true, pon CAMERA_ENABLED=false (observador
# clásico) o dale a cada uno un CAMERA_INDEX distinto. El CameraManager toma
# un cerrojo y avisa si hay conflicto, pero es mejor configurarlo bien.
# ===========================================================================

# Motor de percepción completo (OCR, escena, acciones, emociones).
# Con false, el paquete vision/ se comporta como antes de esta integración.
VISION_PERCEPTION_ENABLED=true

# Interruptor de cámara PROPIO del motor nuevo. Déjalo vacío salvo que quieras
# forzarlo: con VISION_REPLACE_LEGACY=true el motor enciende la cámara aunque
# CAMERA_ENABLED=false (que ahí solo apaga el observador clásico).
# VISION_CAMERA_ENABLED=true

# --- Cámara ---
# Backend de captura: auto (vacío) | msmf | dshow | v4l2 | any
# Si la cámara abre pero no entrega imagen, ejecuta
#   python diag_vision_avanzada.py --camara
# y pon aquí el backend que la sección 6 te recomiende.
VISION_CAMERA_BACKEND=dshow
VISION_MAX_PEOPLE=4
VISION_DEVICE=auto
VISION_DEBUG=false
VISION_AUTO_SEARCH_CAMERA=true
VISION_MAX_CAMERA_INDEX=4

# --- Manos y dedos (21 puntos por mano) ---
VISION_HANDS_ENABLED=true
VISION_HAND_FPS=0

# --- Lectura de textos por cámara (OCR) ---
# Motor: auto | paddleocr | easyocr | tesseract | ninguno. Todos LOCALES.
#   pip install paddleocr        (mejor calidad en español)
#   pip install easyocr          (buena alternativa)
#   Tesseract ya viene con YUE para el OCR de pantalla.
VISION_OCR_ENABLED=true
VISION_OCR_ENGINE=auto
VISION_OCR_LANGUAGES=es
# Para añadir inglés más adelante:  VISION_OCR_LANGUAGES=es,en
#
# true = YUE NO lee sola; espera a que le digas "lee esto". Recomendado.
VISION_OCR_ONLY_ON_REQUEST=true
# Fotogramas que deben coincidir antes de dar un texto por estable.
VISION_OCR_MIN_AGREEMENTS=3
VISION_OCR_MIN_CONFIDENCE=0.35
VISION_TEXT_WATCH_FPS=0.5

# --- Descripción de la habitación ---
VISION_SCENE_DESCRIPTION_ENABLED=true
VISION_SCENE_FPS=0.3

# --- Reconocimiento de acciones (análisis temporal, 22 acciones) ---
VISION_ACTIONS_ENABLED=true
VISION_ACTION_FPS=6

# --- Estimación afectiva ---
# Es una ESTIMACIÓN probabilística, nunca un hecho psicológico. YUE jamás
# diagnostica ni afirma emociones como certezas.
VISION_EMOTIONS_ENABLED=true
VISION_EMOTION_MIN_CONFIDENCE=0.45
# El ritmo de voz solo se usa como señal afectiva con permiso EXPLÍCITO.
VISION_EMOTION_USE_VOICE=false

# --- Antirrebote de eventos visuales ---
VISION_EVENT_MIN_DURATION=0.45
VISION_EVENT_COOLDOWN=4

# --- Privacidad (los valores por defecto son los más restrictivos) ---
VISION_PROCESS_LOCAL=true
VISION_SAVE_EVENTS=false
VISION_ALLOW_CLOUD=false
# Con true, YUE no analiza NADA hasta que se lo pidas expresamente.
VISION_ONLY_ON_REQUEST=false

# --- Modelos (models/vision/). NUNCA se descargan solos. ---
VISION_MODEL_VARIANT=full
VISION_ALLOW_DOWNLOAD=false
# Rutas puntuales:  VISION_MODEL_HAND_LANDMARKER_PATH=C:\ruta\hand_landmarker.task

# --- Migración desde el CameraObserver clásico ---
# Con true, self.camera pasa a ser un adaptador que habla con el motor nuevo.
# El control del cursor por cabeza SIGUE FUNCIONANDO: el motor entrega los
# landmarks crudos igual que el observador clásico. Actívalo cuando quieras
# usar una sola webcam para todo.
VISION_REPLACE_LEGACY=true
# FPS de los landmarks del control por cabeza (0 = 18, el valor recomendado).
VISION_HEAD_CONTROL_FPS=0
# ===== Capa reactiva de visión (percepción -> avatar y voz) =====
# Sin esto la visión mide todo perfectamente y no mueve nada: es el eslabón que
# conecta lo que YUE ve con lo que YUE hace.
VISION_REACTIVE_ENABLED=true
VISION_REACTIVE_AVATAR=true
VISION_REACTIVE_SPEECH=true
# Frecuencia de bombeo del estado (Hz). 4 basta y no gasta CPU.
VISION_REACTIVE_POLL_HZ=4
# Enfriamientos en segundos: suben si YUE se pone pesada, bajan si es muy sosa.
VISION_REACTIVE_GREET_COOLDOWN=45
VISION_REACTIVE_EMOTION_COOLDOWN=25
VISION_REACTIVE_COMMENT_COOLDOWN=90
VISION_REACTIVE_OBJECT_COOLDOWN=240
VISION_REACTIVE_GAZE_COOLDOWN=180
# Contacto visual sostenido antes de que YUE inicie conversación.
VISION_REACTIVE_GAZE_SECONDS=3.5
VISION_REACTIVE_GAZE_OPENS_CHAT=true
# Tope duro de frases por minuto salidas de la visión.
VISION_REACTIVE_MAX_PHRASES_PER_MINUTE=2
# OCR automático cuando aparece un documento estable (además de bajo petición).
VISION_OCR_AUTO_ON_DOCUMENT=true
VISION_OCR_DOCUMENT_MIN_SCORE=0.55



EPISODIC_DEBUG=true

# ===========================================================================
# MEMORIA NARRATIVA - Story Memory (core/story_memory.py)
# ===========================================================================
# CUARTA capa de memoria. Las tres anteriores recuerdan HECHOS; esta recuerda
# HISTORIAS: hilos de tu vida que evolucionan durante semanas o meses (una
# amistad con algo pendiente, una meta, un proyecto). Es lo que permite que
# "Andrea volvio a escribirme" signifique algo quince dias despues de aquella
# discusion, en vez de ser una frase suelta.
#
# Es ADITIVA: no sustituye ni toca memoria_larga (resumen consolidado),
# emotional_episodes (acontecimientos) ni el retrieval historico.
#
# Reparto de papeles, para que ninguna capa pise a otra:
#   recent_messages(12) -> continuidad inmediata de la charla
#   episodic            -> QUE te paso y como termino
#   memory_ext          -> que dijiste hace tiempo que encaja con ESTE mensaje
#   story_memory        -> que HILO de tu vida seguis los dos
#
# La via principal es DETERMINISTA (patrones del espanol + lo que la memoria
# episodica ya calculo), asi que funciona igual sin conexion. El LLM solo
# enriquece en la consolidacion periodica, y es opcional.
STORY_MEMORY_ENABLED=true

# Cuantas historias como MAXIMO entran en el prompt. Deliberadamente bajo: si
# YUE mete seis historias en cada mensaje deja de conversar y empieza a
# recitar. Ademas una historia solo entra si el mensaje la TOCA de verdad.
STORY_MAX_CONTEXT=2
# Relevancia minima para entrar al contexto. Por debajo, es preferible no
# recordar nada.
STORY_CONTEXT_MIN_SCORE=0.45
STORY_MAX_CANDIDATES=60

# --- Umbrales para NO sobre-memorizar --------------------------------------
STORY_MIN_CHARS=8
# Carga emocional minima (0..1) para que un mensaje SIN relacion dicha y SIN
# episodio detras genere historia. Es lo que impide que "hoy comi pizza" acabe
# siendo un capitulo de tu vida.
STORY_MIN_INTENSITY=0.50
# Minimos para CREAR una historia nueva desde la consolidacion con modelo. Las
# que ya existen se actualizan siempre.
STORY_MIN_SIGNIFICANCE=0.35
STORY_MIN_CONFIDENCE=0.45

# --- Confianza: lo dicho pesa mas que lo deducido --------------------------
STORY_CONF_EXPLICIT=0.90
STORY_CONF_INFERRED=0.55
STORY_CONF_HEDGED=0.40
STORY_CONF_STEP=0.30
# Techos. El de lo inferido es MAS BAJO a proposito: una suposicion repetida
# muchas veces sigue siendo una suposicion, no asciende a hecho por insistir.
STORY_CONF_CAP=0.97
STORY_CONF_INFERRED_CAP=0.75
# Techo para lo que proponga el modelo en la consolidacion.
STORY_LLM_CONF_CAP=0.80

# Umbrales de la etiqueta legible (alta/media/baja). El numero sigue mandando.
STORY_SIGNIFICANCE_HIGH=0.70
STORY_SIGNIFICANCE_MED=0.40

# --- Cierre sin nombre ("ya hablamos y nos reconciliamos") ------------------
# Dias hacia atras en los que se acepta cerrar por anafora la historia de
# PERSONA tocada mas recientemente que tuviera algo pendiente. Fuera de esa
# ventana no se cierra nada: mejor seguir creyendo que sigue abierto que dar
# por resuelto lo que no consta.
STORY_ANAPHORA_DAYS=21

# --- Metas -----------------------------------------------------------------
# Abre un hilo narrativo para cada meta activa del sistema goals de siempre.
# NO reemplaza esa tabla. El progreso se queda en NULL mientras no haya
# evidencia: un numero inventado es peor que no saber.
STORY_GOALS_ENABLED=true
STORY_GOALS_MAX=10

# --- Consolidacion narrativa ------------------------------------------------
# Cada cuantos dias, como MINIMO, se revisan las historias. La parte
# determinista (metas y recalculo de peso) NO necesita modelo.
STORY_CONSOLIDATION_DAYS=7
# Capa OPCIONAL de enriquecimiento con LLM. En false, Story Memory sigue
# funcionando entera por la via determinista.
STORY_CONSOLIDATION_ENABLED=true
STORY_USE_LLM=true
STORY_MAX_LLM_CALLS=4
STORY_LLM_TIMEOUT=25
STORY_MAX_PER_CONSOLIDATION=4

# Paquete de evidencia que se manda al modelo: YA PROCESADA, no un volcado de
# cientos de mensajes crudos.
STORY_EVIDENCE_DAYS=30
STORY_EVIDENCE_MAX_CHARS=4000

# Dias sin evidencia tras los cuales una historia pasa a 'dormant'. NO se
# borra: si vuelves a nombrarla, sigue ahi entera.
STORY_DORMANT_DAYS=120

# En terreno de riesgo manda el sistema de seguridad: a partir de este nivel no
# se construyen historias. Mismo criterio que la memoria episodica.
STORY_SAFETY_BLOCK_LEVEL=2

# Log [STORY] en la consola. Nunca imprime tu mensaje completo.
STORY_DEBUG=false
