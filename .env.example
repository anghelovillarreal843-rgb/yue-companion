# ============================================================
# YUE · configuracion privada
# Copia este archivo como .env y agrega tus claves.
# ============================================================

# --- IA (Groq) ----------------------------------------------
GROQ_API_KEY=TU_CLAVE_GROQ_AQUI
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
TEMPERATURE=0.85

# --- Varias IAs con relevo automático (multi-proveedor) -----
# Router que prueba varios proveedores GRATIS en fila: si uno se cae o se queda
# sin cupo, pasa al siguiente al instante. Solo pega las claves que tengas; los
# proveedores sin clave simplemente no entran. Todas son APIs compatibles con
# OpenAI, así que funcionan igual. (Ver core/ai_router.py.)
#   Groq        -> ya está arriba (GROQ_API_KEY). Gratis y muy rápido.
#   Gemini      -> https://aistudio.google.com/app/apikey (capa gratis)
#   Cerebras    -> https://cloud.cerebras.ai (capa gratis, muy rápido)
#   OpenRouter  -> https://openrouter.ai/keys (tiene modelos ":free")
#   OpenAI      -> https://platform.openai.com (NO es gratis; opcional)
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Modelo por proveedor (opcional; si lo dejas vacío usa uno por defecto sensato):
GEMINI_MODEL=gemini-2.0-flash
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Respaldo de modelos si Groq retira el del .env -----------
# Groq devuelve 404 cuando un modelo es retirado. Si eso pasa, Yue consulta
# /v1/models y usa el primero de estas listas que siga vivo.
GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
GROQ_VISION_FALLBACKS=meta-llama/llama-4-maverick-17b-128e-instruct,meta-llama/llama-4-scout-17b-16e-instruct

# --- Vision de pantalla -------------------------------------
# Activa desde el inicio, pero no comenta periódicamente. /mira hace una consulta explícita.
VISION_ENABLED=true
VISION_AUTOCOMMENT=false
VISION_INTERVAL=90

# --- Camara local automatica --------------------------------
# Se conecta si encuentra una webcam. No guarda ni envia fotogramas a la IA.
CAMERA_ENABLED=true
CAMERA_ANALYSIS_INTERVAL=1.2
CAMERA_RETRY_INTERVAL=60
# NUEVO (autoconexion): si NO hay camara aun, sondea cada X segundos y se
# engancha sola en cuanto enciendas/conectes una, sin reiniciar YUE.
CAMERA_SEARCH_INTERVAL=3
CAMERA_MAX_INDEX=3
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_MAX_PEOPLE=2
CAMERA_CONTEXT_IN_CHAT=true
CAMERA_CONTEXT_MAX_AGE=8

# Si es false (por defecto), YUE solo HABLA y no escribe sus respuestas en el chat.
# Ponlo en true si prefieres ver también el texto. Si la voz está apagada, el
# texto se muestra igual para que YUE no se quede muda.
CHAT_MOSTRAR_RESPUESTAS=false
# Descarga una sola vez los modelos oficiales de MediaPipe en data/models/.
CAMERA_DOWNLOAD_MODELS=true

# --- NUEVO: lectura de emociones por camara ---------------------------------
# YUE estima como te sientes por tu expresion y ACOMPANA con la cara del avatar
# (si te ve triste, se preocupa; no imita el enfado). Solo pone gesto, no habla.
CAMERA_EMPATHY_ENABLED=true
CAMERA_EMPATHY_MIN_CONFIDENCE=0.55
CAMERA_EMPATHY_MIN_GAP=8.0

# --- NUEVO: reaccion emocional al audio (musica / videos) -------------------
# YUE afina su cara con lo que SIENTE al escuchar (melancolica con algo lento y
# oscuro, tierna con algo suave, con chispa con lo movido...). Ponlo en false
# para volver a la reaccion de audio anterior.
AUDIO_FEEL_EMOTIONS=true

# --- Vision: proveedor aparte -------------------------------
# Tu cuenta de Groq ya no tiene modelos con vision. Opciones:
#   none      -> Yue planifica con ui_elements + OCR (funciona ya, sin tocar nada)
#   together  -> usa TOGETHER_API_KEY, que ya tienes mas abajo
#   openai    -> usa OPENAI_IMAGE_KEY, que ya tienes mas abajo
#   groq      -> vuelve a intentarlo en Groq (por si reponen un modelo)
VISION_PROVIDER=none
# Solo si eliges together u openai; si lo dejas vacio se usa el de por defecto.
VISION_MODEL=
# Clave de tu proveedor de vision. En Together es un hexadecimal largo (NO empieza
# por "key_"); consiguela en https://api.together.ai/settings/api-keys
VISION_API_KEY=
VISION_BASE_URL=
# Si es true, al arrancar Yue valida la clave de vision (GET /models) y avisa en el
# chat si el proveedor la rechaza (401/403), en vez de fallar en silencio.
VISION_PREFLIGHT=true
# Vision SOLO por OCR: Yue "mira" leyendo el TEXTO de la pantalla (no usa modelo
# multimodal ni clave). Ideal para PDFs/documentos/paginas con texto. Requiere
# Tesseract-OCR. Ponlo en true si no tienes una clave de vision valida.
VISION_OCR_ONLY=false

# --- Voz -----------------------------------------------------
TTS_ENGINE=kokoro
TTS_ENABLED=true
KOKORO_VOICE=ef_dora
KOKORO_LANG=es
KOKORO_SPEED=1.06
# KOKORO_MODEL=assets/kokoro/kokoro-v1.0.onnx
# KOKORO_VOICES=assets/kokoro/voices-v1.0.bin
TTS_LANG=es
TTS_TLD=com.mx

# --- Microfono y antieco ------------------------------------
MIC_ENABLED=true
MIC_LANG=es-PE
MIC_DEVICE_INDEX=
MIC_ENERGY_THRESHOLD=250
MIC_DYNAMIC=true
# Silencio que marca fin de frase. Mas bajo = responde mas rapido (antes 0.8).
MIC_PAUSE=0.55
MIC_PHRASE_LIMIT=14
# Tras hablar, vuelve a escucharte antes (antes 1.2).
MIC_ECHO_COOLDOWN=0.6
MIC_ECHO_SIMILARITY=0.68
MIC_BARGE_IN_ENABLED=true
MIC_BARGE_IN_REQUIRE_WAKE_WORD=false
MIC_BARGE_IN_MIN_CHARS=5
MIC_WAKE_WORDS=yue,oye yue

# NUEVO: interrupcion por voz fiable (barge-in inteligente).
# Hace que hablarle por voz mientras ella habla la detenga, igual que al escribir.
# Ponlo en false para volver EXACTAMENTE al filtrado anterior.
MIC_BARGE_IN_SMART=true
# Longitud minima (caracteres) para interrumpir con voz que no sea una orden.
MIC_BARGE_IN_GATE_MIN_CHARS=4
# Solape de palabras con su propio TTS por encima del cual se trata como eco.
# Mas ALTO = mas permisivo con tu voz mientras habla (antes efectivo ~0.34).
MIC_BARGE_IN_ECHO_OVERLAP=0.62
# Palabras extra que fuerzan interrupcion inmediata, separadas por comas
# (ya vienen de serie: para, espera, detente, callate, oye, stop, yue...).
MIC_BARGE_IN_WORDS=

# Filtro de audio de video/musica en el microfono (peticion 2):
# mientras suena un video o musica, ese sonido NO se toma como que le hablas tu.
# Con REQUIRE_WAKE_WORD=true, di "Yue..." para que te haga caso viendo algo.
MIC_MEDIA_GUARD_ENABLED=true
MIC_MEDIA_GUARD_REQUIRE_WAKE_WORD=true
MIC_MEDIA_GUARD_MIN_CHARS=8

# --- Palabra de activacion «Yue» y avisos de consola ---
# WAKE_WORD_ENABLED=false: YUE responde a TODO lo que le digas o escribas sin que
# tengas que empezar por «Yue». Ponlo en true si prefieres que solo atienda cuando
# la llames por su nombre.
WAKE_WORD_ENABLED=false
# DEBUG_STATUS=false: no llena la terminal con avisos repetidos («modo multimedia
# activo/en reposo», «escuchando…»). Ponlo en true solo si necesitas depurar.
DEBUG_STATUS=false

# Refuerzo para que Yue no se escuche a si misma (peticion 3):
# segundos extra de vigilancia de eco tras hablar, y umbral de solape con su TTS
# (mas bajo = mas estricto).
MIC_SELF_LISTEN_TAIL=2.5
MIC_SPEAKING_ECHO_OVERLAP=0.34

# Perfilador de contenido: video normal vs video musical (peticion 1).
MEDIA_PROFILE_WINDOW=12.0
MEDIA_PROFILE_MIN_SAMPLES=6
MEDIA_PROFILE_HYSTERESIS=3
MEDIA_PROFILE_SILENCE_RATIO=0.75
MEDIA_PROFILE_MUSIC_RATIO=0.62
MEDIA_PROFILE_VOICE_RATIO=0.30
MEDIA_PROFILE_TEMPO_CV=0.18
AUDIO_MEDIA_ON_BLOCKS=2
AUDIO_MEDIA_OFF_BLOCKS=6

# Acompañamiento multimedia continuo (audio + frames + emoción + memoria).
MEDIA_COMPANION_ENABLED=true
MEDIA_COMPANION_VISUAL_ENABLED=true
MEDIA_COMPANION_COMMENTS_ENABLED=true
MEDIA_COMPANION_AVATAR_ENABLED=true
# Intervalo adaptativo: siempre entre 0.5 y 2.0 s.
MEDIA_COMPANION_VISUAL_INTERVAL=1.0
MEDIA_COMPANION_VISUAL_MIN_INTERVAL=0.5
MEDIA_COMPANION_VISUAL_MAX_INTERVAL=2.0
MEDIA_COMPANION_SCENE_CHANGE_THRESHOLD=0.025
MEDIA_COMPANION_VISUAL_STALE_SECONDS=12
MEDIA_COMPANION_VISION_TIMEOUT=18
MEDIA_COMPANION_VISION_RETRY_SECONDS=60
# Cuánto habla y cuánto tarda en volver a comentar.
MEDIA_COMPANION_COMMENT_MIN_GAP=45
MEDIA_COMPANION_COMMENT_MAX_GAP=150
MEDIA_COMPANION_SPONTANEITY=0.48
# Evolución emocional gradual.
MEDIA_COMPANION_EMOTION_INTENSITY=1.0
MEDIA_COMPANION_EMOTION_RISE_SECONDS=3.2
MEDIA_COMPANION_EMOTION_FALL_SECONDS=7.0
MEDIA_COMPANION_MUSIC_SENSITIVITY=1.0
MEDIA_COMPANION_VISUAL_SENSITIVITY=1.0
# 0 = sin movimiento al ritmo; 1 = movimiento discreto completo.
MEDIA_COMPANION_AVATAR_MOTION=0.72

# --- Avatar --------------------------------------------------
PET_HEIGHT=330
USE_VRM=true
AVATAR_WIDTH=320
AVATAR_HEIGHT=520
AVATAR_TURN=0
AVATAR_ARM_DOWN=1.48
AVATAR_ARM_FWD=0.35
AVATAR_ARM_IN=0.12
AVATAR_CAM_DIST=1.85
AVATAR_CAM_Y=-0.16
AVATAR_DEBUG=false
# Gesticulacion: 0=solo balanceo, 1=normal, 1.5=teatral
AVATAR_GESTURE_GAIN=1.0

# --- Control seguro del PC ----------------------------------
PC_MAX_ACTIONS=24
PC_MAX_CYCLES=6
PC_MAX_ACTIONS_PER_CYCLE=4
PC_VISUAL_RECHECK=true
# Ojos por OCR (necesita Tesseract, ya lo tienes)
PC_OCR_CONTEXT=true
# Apartar las ventanas de Yue del mouse (false si algo se cuelga)
PC_CLICK_THROUGH=true
PC_CLICK_THROUGH_TIMEOUT=1.0
PC_OCR_MAX_CHARS=900
PC_ACTION_PAUSE=0.08
PC_TYPE_INTERVAL=0.012
PC_MAX_TYPE_CHARS=4000
# Motor autónomo: grafo, cola, locks, recuperación y bitácora JSONL
PC_AGENT_MAX_WORKERS=3
PC_AGENT_PARALLEL=true
PC_AGENT_RETRY_ATTEMPTS=3
PC_AGENT_WAIT_TIMEOUT=10
PC_AGENT_APP_TIMEOUT=15
PC_AGENT_MAX_REPLANS=6
PC_AGENT_LOG_PATH=data/logs/pc_agent.jsonl

# ---- Verificacion por accion (¿la pantalla cambio de verdad?) ----
PC_VERIFY_ACTIONS=true
PC_VERIFY_DELAY=0.35
PC_VERIFY_HASH_DISTANCE=1
PC_VERIFY_PIXEL_RATIO=0.0015
PC_VERIFY_PIXEL_DELTA=14
# Ventanas propias de Yue que se enmascaran antes de comparar (el avatar se mueve solo)
PC_VERIFY_IGNORE_TITLES=yue_companion,yue

# ---- Contexto de UI real (pywinauto, solo Windows) ----
PC_UI_CONTEXT=true
PC_UI_MAX_ELEMENTS=40
PC_UI_MAX_WINDOWS=18

# ---- OCR de pantalla (accion click_text) ----
OCR_ENGINE=pytesseract
OCR_LANG=spa+eng
OCR_MIN_CONF=55
# Ruta a tesseract.exe si no esta en el PATH:
# OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSERACT_CMD=

# ---- Aprendizaje continuo de ordenes de PC ----
LEARNING_ENABLED=true
LEARNING_SIM_THRESHOLD=0.85
LEARNING_MIN_SUCCESSES=2
LEARNING_MIN_RATIO=0.7
LEARNING_FAIL_STREAK=2
LEARNING_LESSON_THRESHOLD=0.55
LEARNING_MAX_SKILLS=200
LEARNING_MAX_LESSONS=200
LEARNING_MAX_PLAN_STEPS=24
LEARNING_REFLECT=true

# --- Verificacion por celdas (clics pequenos) ----------------
# El ratio global no ve un digito de la calculadora. Mirando la celda que mas
# cambio, si lo detecta. Sube PC_VERIFY_TILE_RATIO si aparecen falsos positivos.
PC_VERIFY_TILES=8
PC_VERIFY_TILE_RATIO=0.02

# --- Autonomia local y segura -------------------------------
AUTONOMY_ENABLED=true
# Intervalo entre revisiones autonomas, en segundos.
AUTONOMY_INTERVAL=600
# Solo crea cuando llevas este tiempo sin escribir ni hablarle.
AUTONOMY_IDLE_SECONDS=120
AUTONOMY_NOTIFY=true
AUTONOMY_MAX_PER_SESSION=3
AUTONOMY_PC_ENABLED=true
AUTONOMY_OPEN_CREATIONS=true

# --- Seguridad emocional ------------------------------------
CRISIS_RESOURCES=Si estas en peligro inmediato, contacta a los servicios de emergencia de tu pais o a una persona de confianza.

# --- Generacion multimedia opcional -------------------------
FLUX_PROVIDER=together
TOGETHER_API_KEY=
TOGETHER_MODEL=black-forest-labs/FLUX.1-schnell-Free
TOGETHER_BASE_URL=https://api.together.xyz/v1
BFL_API_KEY=
BFL_BASE_URL=https://api.bfl.ai
BFL_MODEL=flux-dev
OPENAI_IMAGE_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
LOCAL_FLUX_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_WIDTH=768
IMAGE_HEIGHT=1024
FLUX_STEPS=4
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_SECONDS=16
VIDEO_FPS=30

# ---- Control PC avanzado (Jarvis) ----
PC_OFFICE_COM_ENABLED=true
PC_OFFICE_FALLBACK_KEYBOARD=true
PC_APP_SCAN_ON_START=true
PC_APP_CATALOG_MAX_AGE_HOURS=72
PC_ACTION_LOG_SIZE=8
# Permisos granulares: false = rechazo directo, aunque haya confirmación.
PERM_ENVIAR_CORREOS=true
PERM_BORRAR_ARCHIVOS=true
PERM_USAR_TERMINAL=true
PERM_INSTALAR_SOFTWARE=true
PERM_CERRAR_VENTANAS=true
PERM_SOBRESCRIBIR_ARCHIVOS=true

# ==========================================================================
# YUE V3 PERCEPTION SYSTEM (opt-in). Cámara local que estima presencia, rostro,
# emoción y atención con OpenCV + MediaPipe + DeepFace. Todo local: nunca guarda
# ni envía imágenes. APAGADO por defecto para no pelear por la webcam con el
# observador clásico. Si lo enciendes, pon CAMERA_ENABLED=false (o dale otra
# CAMERA_INDEX) para que no compitan por la misma cámara.
# ==========================================================================
VISION_V3_ENABLED=false
CAMERA_INDEX=0
CAMERA_PRIVACY_MODE=true

# Perfil de rendimiento: auto | LOW | MEDIUM | HIGH
#   LOW=DeepFace/8s ~12FPS · MEDIUM=DeepFace/5s ~20FPS · HIGH=DeepFace/2s ~30FPS
VISION_PERF_PROFILE=auto
# Overrides finos (0 = usar lo del perfil)
VISION_EMOTION_INTERVAL=0
VISION_TARGET_FPS=0

# Quién comenta lo que ve (YUE | KAI) y cuánto habla
VISION_EMOTION_PERSONA=YUE
MAX_EMOTION_RESPONSES_PER_HOUR=4
VISION_EMOTION_MIN_CONFIDENCE=60
VISION_EMOTION_COOLDOWN=120
VISION_AVATAR_MIN_GAP=6

# Atención: ausencia larga (s) y semiancho de la zona central "mira de frente"
VISION_ABSENCE_SECONDS=600
VISION_ATTENTION_CENTER_BAND=0.22
